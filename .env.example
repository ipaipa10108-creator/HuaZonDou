# 華榮道 React Vite 遊戲環境變數配置
# 請複製此檔案為 .env 並填入實際值

# Google Apps Script Web App URL
# 用於將遊戲成績提交至 Google Sheets
# 請在 Google Sheets 擴充功能中建立 Apps Script，部署為 Web App 後取得 URL
VITE_GOOGLE_APP_SCRIPT_URL=https://script.google.com/macros/s/your_script_id/exec

# 專案基礎路徑（用於 GitHub Pages 部署）
# 如果部署到 https://username.github.io/HuaZonDou/，則設為 /HuaZonDou/
# 如果部署到根目錄，則設為 /
VITE_BASE_URL=/HuaZonDou/
